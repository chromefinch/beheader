name: Custom.Windows.Detection.Yara.RecentUserFiles
author: |
  Adapted from Generic.Detection.Yara.Glob by Matt Green - @mgreen27
description: |
  Runs YARA rules against recently created or modified files in user
  directories, excluding AppData and other high-noise subtrees.

  Adapted from Matt Green's `Generic.Detection.Yara.Glob`. Changes from the
  original:

  1. **`LookbackHours`** — a relative window instead of absolute
     `DateAfter`/`DateBefore` timestamps. "Files touched in the last 24 hours"
     is what you actually want for recurring collection; absolute dates mean
     editing the artifact every run. Absolute dates still work and take over
     if `LookbackHours` is 0.

  2. **`ExcludeRegex`** — glob has no native exclusion, so paths are filtered
     after enumeration. Defaults to dropping `AppData`, `Application Data` and
     `Local Settings`, which is where browser caches, package managers and
     Teams/Slack blobs live. Those directories are the bulk of file churn in a
     user profile and almost none of it is interesting.

  3. **Timestamp selection.** The original ORs across Mtime, Atime, Ctime and
     Btime. `Atime` updates when a file is merely *read* — including by your
     own scan, by indexing, and by AV — so including it makes "recently
     modified" mean "recently touched by anything". The default here is Mtime
     OR Btime, which is genuinely created-or-modified. Set `UseAllTimestamps`
     to restore the original behaviour.

  4. **`Blocksize`** — pinned so files are scanned in a single pass. Without
     it `yara()` scans in independent blocks, which breaks anchored strings
     (`at 0`, `in (0..N)`) and count conditions (`#string > N`), and can miss a
     long run that straddles a boundary.

  ### Making this continuous
  This is a `CLIENT` artifact — point in time. For ongoing coverage, schedule
  it as a recurring hunt with `LookbackHours` set slightly longer than the
  interval so consecutive windows overlap. Hourly runs with
  `LookbackHours: 2` means nothing can fall between them.

  ### Glob examples
  * All user profiles, MP4 only: `C:/Users/*/**/*.mp4`
  * Multiple extensions: `C:/Users/*/**/*.{mp4,ico,jpg,wav}`
  * One user: `C:/Users/player1/**/*.mp4`
  * Downloads and Desktop only: `C:/Users/*/{Downloads,Desktop}/**/*.mp4`

  NOTE: runs glob with `nosymlink` on, so symlinks are not followed.

type: CLIENT

parameters:
  - name: PathGlob
    description: Only file names that match this glob will be scanned.
    default: 'C:/Users/*/**/*.mp4'

  - name: ExcludeRegex
    description: |
      Paths matching this regex are dropped after globbing. Must not be empty —
      an empty regex matches everything and would exclude all results.
      Matches both slash styles since OSPath renders with backslashes.
    default: '(?i)[\\/](AppData|Application Data|Local Settings)[\\/]'

  - name: LookbackHours
    description: |
      Scan files created or modified within this many hours. Set to 0 to use
      the absolute DateAfter/DateBefore parameters instead.
    type: int
    default: 24

  - name: UseAllTimestamps
    description: |
      Match on Mtime, Atime, Ctime OR Btime like the original artifact.
      Off by default because Atime updates on read, not just on write.
    type: bool
    default: N

  - name: SizeMax
    description: maximum size of target file.
    type: int64
    default: 104857600

  - name: SizeMin
    description: minimum size of target file.
    type: int64
    default: 4096

  - name: Blocksize
    description: |
      Bytes read per YARA scan pass. Should exceed SizeMax so each file is
      scanned in one pass. Bounds peak memory per file.
    type: int64
    default: 104857600

  - name: UploadHits
    type: bool

  - name: DateAfter
    type: timestamp
    description: "Used only when LookbackHours is 0. YYYY-MM-DDTmm:hh:ssZ"

  - name: DateBefore
    type: timestamp
    description: "search for events before this date. YYYY-MM-DDTmm:hh:ssZ"

  - name: YaraUrl
    description: If configured will attempt to download Yara rules form Url
    type: upload

  - name: YaraRule
    type: yara
    description: Final Yara option and the default if no other options provided.
    default: |
      rule B64_MP4_Padded {
          meta:
              author = "Antigravity"
              severity = "high"
              tier = 3
          strings:
              $padded = /[A-Za-z0-9+\/]{200,}={1,2}/
          condition:
              $padded
      }

      rule B64_MP4_Chunked {
          meta:
              author = "Antigravity"
              severity = "high"
              tier = 3
          strings:
              $chunked = /([A-Za-z0-9+\/]{60,100}[\r\n]{1,2}){8}/
          condition:
              $chunked
      }

      rule B64URL_MP4_LongRun {
          meta:
              author = "Antigravity"
              severity = "medium"
              tier = 2
          strings:
              $urlsafe = /[A-Za-z0-9_-]{250,}={0,2}/
          condition:
              $urlsafe
      }

      rule B64_MP4_LongRun {
          meta:
              author = "Antigravity"
              severity = "medium"
              tier = 2
          strings:
              $run = /[A-Za-z0-9+\/]{300,}/
          condition:
              $run
      }

  - name: NumberOfHits
    description: |
      Hits to report per file. Raised from the original default of 1 so a
      multi-rule ruleset can report which rules fired, not just the first.
    default: 10
    type: int

  - name: ContextBytes
    description: Include this amount of bytes around hit as context.
    default: 32
    type: int

sources:
  - precondition: |
      SELECT OS From info() where OS = "windows"

    query: |
      -- check which Yara to use
      LET yara_rules <= YaraUrl || YaraRule

      -- Relative lookback wins if set, otherwise fall back to the absolute
      -- DateAfter from the original artifact.
      LET EffectiveAfter <= if(condition=LookbackHours > 0,
            then=timestamp(epoch=now() - (LookbackHours * 3600)),
            else=DateAfter)

      -- time testing
      LET time_test(stamp) =
            if(condition= DateBefore AND EffectiveAfter,
                then= stamp < DateBefore AND stamp > EffectiveAfter,
                else=
            if(condition=DateBefore,
                then= stamp < DateBefore,
                else=
            if(condition= EffectiveAfter,
                then= stamp > EffectiveAfter,
                else= True
            )))

      -- first find all matching glob
      LET files = SELECT OSPath, Name, Size, Mtime, Atime, Ctime, Btime
        FROM glob(globs=PathGlob,nosymlink='True')
        WHERE
          NOT IsDir AND NOT IsLink
          AND NOT OSPath =~ ExcludeRegex
          AND if(condition=SizeMin,
            then= SizeMin < Size,
            else= True)
          AND if(condition=SizeMax,
            then=SizeMax > Size,
            else= True)
          AND if(condition=UseAllTimestamps,
            then=
             ( time_test(stamp=Mtime)
            OR time_test(stamp=Atime)
            OR time_test(stamp=Ctime)
            OR time_test(stamp=Btime)),
            else=
             ( time_test(stamp=Mtime)
            OR time_test(stamp=Btime)))

      -- scan files and prepare hit metadata
      LET hits = SELECT * FROM foreach(row=files,
            query={
                SELECT
                    OSPath,
                    File.Size as Size,
                    Mtime, Atime, Ctime, Btime,
                    Rule, Tags, Meta,
                    String.Name as YaraString,
                    String.Offset as HitOffset,
                    upload( accessor='scope',
                            file='String.Data',
                            name=format(format="%v-%v-%v",
                            args=[
                                OSPath,
                                if(condition= String.Offset - ContextBytes < 0,
                                    then= 0,
                                    else= String.Offset - ContextBytes),
                                if(condition= String.Offset + ContextBytes > Size,
                                    then= Size,
                                    else= String.Offset + ContextBytes) ]
                            )) as HitContext
                FROM yara(rules=yara_rules,files=OSPath,
                  context=ContextBytes,number=NumberOfHits,
                  blocksize=Blocksize)
            })

      -- upload files if selected
      LET upload_hits = SELECT *, upload(file=OSPath,name=OSPath) as Upload FROM hits

      -- return rows
      SELECT * FROM if(condition= UploadHits,
                        then= upload_hits,
                        else= hits )

column_types:
  - name: HitContext
    type: preview_upload
